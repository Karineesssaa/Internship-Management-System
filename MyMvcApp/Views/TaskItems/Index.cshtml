@model IEnumerable<MyMvcApp.Models.TaskItem>

@{
    ViewData["Title"] = "Tasks";
}

<h1>Tasks</h1>

<form asp-action="Index" method="get" class="row mb-3">
    <div class="col-md-3">
        <label class="form-label">Status</label>
        <select name="status" class="form-control" asp-items="ViewBag.Status">
            <option value="">All statuses</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Student</label>
        <select name="studentId" class="form-control" asp-items="ViewBag.Students">
            <option value="">All students</option>
        </select>
    </div>

    <div class="col-md-3">
        <label class="form-label">Group</label>
        <select name="groupId" class="form-control" asp-items="ViewBag.Groups">
            <option value="">All groups</option>
        </select>
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button type="submit" class="btn btn-primary me-2">Filter</button>
        <a asp-action="Index" class="btn btn-secondary">Reset</a>
    </div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Task</a>
</p>

<table class="table table-striped">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.Title)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Description)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Priority)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Deadline)
            </th>
            <th>
                Internship Group
            </th>
            <th>
                Assigned Student
            </th>
            <th>
                Actions
            </th>
        </tr>
    </thead>

    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.Title)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Description)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Priority)
                </td>іі

                <td>
                    @Html.DisplayFor(modelItem => item.Status)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.Deadline)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.InternshipGroup.Name)
                </td>
                <td>
                    @item.AssignedToUser?.Email
                </td>

                <td>
                    <a asp-action="Edit"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-warning">
                        Edit
                    </a>

                    <a asp-action="Details"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-info">
                        Details
                    </a>

                    <a asp-action="Delete"
                       asp-route-id="@item.Id"
                       class="btn btn-sm btn-danger">
                        Delete
                    </a>
                </td>
            </tr>
        }
    </tbody>
</table>