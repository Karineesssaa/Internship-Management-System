@model MyMvcApp.Models.Submission

@{
    ViewData["Title"] = "Review Submission";
}

<h1>Review Submission</h1>

<div class="card mb-3">
    <div class="card-body">
        <p><strong>Task:</strong> @Model.TaskItem?.Title</p>
        <p><strong>Student:</strong> @Model.Student?.Email</p>
        <p><strong>GitHub Link:</strong> <a href="@Model.GitHubLink" target="_blank">@Model.GitHubLink</a></p>
        <p><strong>Comment:</strong> @Model.Comment</p>
        <p><strong>Submitted At:</strong> @Model.SubmittedAt</p>
        <p><strong>Current Status:</strong> @Model.TaskItem?.Status</p>
    </div>
</div>

<form asp-action="Review" method="post">
    <input type="hidden" name="id" value="@Model.Id" />

    <div class="mb-3">
        <label class="form-label">New Status</label>
        <select name="status" class="form-control">
            <option value="Approved">Approved</option>
            <option value="Rejected">Rejected</option>
            <option value="NeedChanges">Need Changes</option>
        </select>
    </div>

    <button type="submit" class="btn btn-success">Save Review</button>
    <a asp-action="Index" class="btn btn-secondary">Back</a>
</form>