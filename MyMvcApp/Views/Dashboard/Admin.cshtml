@{
    ViewData["Title"] = "Admin Dashboard";
}

<h1>Admin Dashboard</h1>

<p class="text-muted">System administration panel</p>

<div class="row">

    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Users Management</h5>
                <p class="card-text">View and edit system users.</p>
                <a asp-controller="Users" asp-action="Index" class="btn btn-primary">
                    Manage Users
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Internship Groups</h5>
                <p class="card-text">Create and manage internship groups.</p>
                <a asp-controller="InternshipGroups" asp-action="Index" class="btn btn-primary">
                    Manage Groups
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Tasks</h5>
                <p class="card-text">View, create and manage all tasks.</p>
                <a asp-controller="TaskItems" asp-action="Index" class="btn btn-primary">
                    Manage Tasks
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Submissions</h5>
                <p class="card-text">Review student submissions.</p>
                <a asp-controller="Submissions" asp-action="Index" class="btn btn-primary">
                    View Submissions
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Grades</h5>
                <p class="card-text">View and manage student grades.</p>
                <a asp-controller="Grades" asp-action="Index" class="btn btn-primary">
                    View Grades
                </a>
            </div>
        </div>
    </div>

    <div class="col-md-4 mb-3">
        <div class="card h-100">
            <div class="card-body">
                <h5 class="card-title">Statistics</h5>
                <p class="card-text">View general system statistics.</p>
                <a asp-controller="Dashboard" asp-action="AdminStatistics" class="btn btn-success">
                    View Statistics
                </a>
            </div>
        </div>
    </div>

</div>