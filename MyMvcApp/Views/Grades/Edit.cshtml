@model MyMvcApp.Models.Grade

@{
    ViewData["Title"] = "Edit Grade";
}

<h1>Edit Grade</h1>

<hr />

<div class="row">
    <div class="col-md-6">
        <form asp-action="Edit" method="post">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <input type="hidden" asp-for="Id" />

            <div class="mb-3">
                <label asp-for="TaskItemId" class="form-label">Task</label>
                <select asp-for="TaskItemId" class="form-control" asp-items="ViewBag.TaskItemId"></select>
                <span asp-validation-for="TaskItemId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="StudentId" class="form-label">Student</label>
                <select asp-for="StudentId" class="form-control" asp-items="ViewBag.StudentId"></select>
                <span asp-validation-for="StudentId" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="Value" class="form-label">Grade Value</label>
                <input asp-for="Value" class="form-control" min="0" max="100" />
                <span asp-validation-for="Value" class="text-danger"></span>
            </div>

            <div class="mb-3">
                <label asp-for="MentorComment" class="form-label">Mentor Comment</label>
                <textarea asp-for="MentorComment" class="form-control" rows="4"></textarea>
                <span asp-validation-for="MentorComment" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary">Save Grade</button>

            <a asp-controller="Grades"
               asp-action="Index"
               class="btn btn-secondary">
                Back to Grades
            </a>
        </form>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}